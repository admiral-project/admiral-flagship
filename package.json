{
  "name": "admiral-flagship",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Admiral admin console - JS tests",
  "scripts": {
    "test": "mocha 'tests/js/**/*.test.js' --timeout 10000",
    "test:watch": "mocha 'tests/js/**/*.test.js' --watch --timeout 10000",
    "coverage": "mkdir -p tests/js/instrumented && npx nyc instrument app/static/js/app.js > tests/js/instrumented/app.js && npx nyc --reporter=text --reporter=html mocha 'tests/js/**/*.test.js' --timeout 10000 && rm -rf tests/js/instrumented"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^4.3.0",
    "eslint": "^10.5.0",
    "jsdom": "^24.0.0",
    "mocha": "^10.4.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@patternfly/patternfly": "^6.6.0"
  }
}
